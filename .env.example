# Copy to .env and edit. Every value here has a working default for the local demo.

# --- LLM for the agent (all free) -------------------------------------------------
# ollama | groq | gemini
AGENTGATE_LLM_PROVIDER=ollama
AGENTGATE_LLM_SMALL_MODEL=qwen3.5:4b
AGENTGATE_LLM_LARGE_MODEL=gemma4:12b
# The free Groq setup the published results use (Groq no longer serves Llama chat models):
#   AGENTGATE_LLM_PROVIDER=groq
#   AGENTGATE_LLM_SMALL_MODEL=openai/gpt-oss-20b
#   AGENTGATE_LLM_LARGE_MODEL=openai/gpt-oss-120b
AGENTGATE_OLLAMA_URL=http://localhost:11434
# Only needed for the matching provider:
GROQ_API_KEY=
GOOGLE_API_KEY=

# The LLM-as-judge baseline (and step-2 fallback). Defaults to the agent's provider
# and its large model.
AGENTGATE_JUDGE_PROVIDER=
AGENTGATE_JUDGE_MODEL=

# --- Decision models (System One API: POST /v1/systemone) ------------------------
# Step 1: strands-decider serve ... (docker compose starts it on :8001)
AGENTGATE_DECIDER_URL=http://localhost:8001
# Step 2: llama-server -hf ggml-org/Clef-Flash-GGUF:Q4_K_M (compose profile "clef", :8002).
# Point this at a Colab/Kaggle tunnel if the laptop is too small.
AGENTGATE_CLEF_URL=http://localhost:8002
# Or use Cloudflare's hosted Clef-flash (free daily allowance, nothing runs locally):
# set the backend to cloudflare and fill in the two values from dash.cloudflare.com.
AGENTGATE_CLEF_BACKEND=local
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Confidence a step needs to settle a call on its own (pick it with `agentgate eval`'s sweep).
AGENTGATE_DECIDER_THRESHOLD=0.9
AGENTGATE_CLEF_THRESHOLD=0.5
# clef | llm_judge -- the PRD's fallback when Clef cannot run.
AGENTGATE_STEP2=clef
# two_step | decider | clef | llm_judge | classifier | keyword | none
AGENTGATE_GATE=two_step
# Use the decider to send easy requests to the small LLM and hard ones to the large one.
AGENTGATE_ROUTER=true

# --- Phone approval ---------------------------------------------------------------
AGENTGATE_SERVER_URL=http://localhost:8080
# Shared secret between the agent, the server and the phone. Leave empty to have
# `agentgate serve` generate one and print it in the QR code.
AGENTGATE_TOKEN=
AGENTGATE_APPROVAL_TIMEOUT_S=60

# --- Sandbox and email ------------------------------------------------------------
AGENTGATE_SANDBOX_DIR=./sandbox
AGENTGATE_AUDIT_DB=./var/audit.sqlite
# outbox: write .eml files into the sandbox (default, nothing leaves the laptop)
# smtp:   really send, but always to AGENTGATE_EMAIL_SELF -- never to the named recipient
AGENTGATE_EMAIL_MODE=outbox
AGENTGATE_EMAIL_SELF=
AGENTGATE_SMTP_HOST=smtp.gmail.com
AGENTGATE_SMTP_PORT=587
AGENTGATE_SMTP_USER=
AGENTGATE_SMTP_PASSWORD=
